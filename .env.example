# ─── Marca (personalize por empresa) ───────────────────────────────
# Nome exibido no login, sidebar, título e PDF de exportação.
NEXT_PUBLIC_APP_NAME="Leads Panel"
# Domínio dos e-mails sintéticos de login (username -> username@dominio).
# Não precisa ser um domínio real; é interno do Supabase Auth.
NEXT_PUBLIC_EMAIL_DOMAIN="leadspanel.app"

# ─── Supabase (obrigatório) ────────────────────────────────────────
# Painel do projeto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_anon_key"
# Chave service_role (SECRETA — só no servidor). Usada por webhook/backfill/admin.
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key"

# ─── Integração Meta Ads (opcional) ────────────────────────────────
# Token de verificação do webhook (você escolhe uma string qualquer).
WEBHOOK_VERIFY_TOKEN="um_token_secreto"
# Token de acesso da Página (gerado via System User do Business Manager).
META_PAGE_ACCESS_TOKEN=""
# App Secret do app do Meta (valida a assinatura HMAC do webhook).
META_APP_SECRET=""
# ID da Página do Facebook usada no backfill de leads.
META_PAGE_ID=""

# ─── Ingestão de leads do site (opcional) ──────────────────────────
# Se definido, POST /api/leads/site exige este token (header x-api-token).
SITE_LEADS_TOKEN=""
